// A conformance app for the MMKV plugin: every shape the contract declares has
// to compile and round-trip on both platforms, so a change to the contract or
// to the value codec shows up as a compile failure here rather than in an app.
//
// Run it with:
//   nexa test --ios      # build/ios
//   nexa test --android  # build/android
plugin "dev.nexa.mmkv" as MMKV

struct PlayerOptions {
    autoplay: Bool,
    volume: Float64,
    state: PlaybackState,
    tags: Array<String>,
}

struct Chapter {
    title: String,
    seconds: Int64,
}

struct BenchmarkObject {
    id: Int32,
    generation: Int32,
    payload: String,
}

struct BenchmarkIntEntry {
    key: String,
    value: Int32,
}

app MmkvConformance {
    enum PlaybackState {
        idle,
        preparing,
        ready,
        playing,
        paused,
        ended,
        failed,
    }

    let store = MMKV.MMKVStore("conformance", "conformance-key", true)
    let benchmarkStore = MMKV.MMKVStore("conformance-benchmark", null, false)
    let compareBenchmarkStore = MMKV.MMKVStore("conformance-benchmark-compare", null, false)
    let benchmarkStringKey = "bench-string"
    let benchmarkStringValue = "benchmark-value"

    state benchmarkGeneration: Int32 = 0
    state benchmarkStartedAt: Int64 = 0
    state benchmarkObjects: Array<BenchmarkObject> = []
    state intReadKeys: Array<String> = []
    state intWriteEntries: Array<BenchmarkIntEntry> = []
    state listReadKeys: Array<String> = []
    state listWriteKeys: Array<String> = []
    state selectedTab: Int32 = 0
    state stringReadNs: Int64 = 0
    state stringWriteNs: Int64 = 0
    state stringWriteWithoutComparisonNs: Int64 = 0
    state compareBeforeSetDisabled: Bool = false
    state intReadNs: Int64 = 0
    state intWriteNs: Int64 = 0
    state listReadNs: Int64 = 0
    state listWriteNs: Int64 = 0

    state launches: Int32 = 0
    state ratio: Float64 = 0
    state enabled: Bool = false
    state name: String = ""
    state raw: Bytes? = null
    state options: PlayerOptions? = null
    state chapters: Array<Chapter> = []
    state tags: Set<String> = []
    state highScores: Map<String, Int32> = ["none": 0]
    state keys: Array<String> = []
    state keyCount: Int64 = 0
    state totalSize: Int64 = 0
    state actualSize: Int64 = 0
    state pageSize: Int64 = 0

    body {
        AppBottomBar(selected: selectedTab) {
            Tab(index: 0, label: "Benchmark", icon: "speedometer") {
                Column(spacing: 12) {
                    Text("MMKV benchmark — total nanoseconds")
                    Text("String benchmarks use an unencrypted single-process store and reuse one key and value; setup and warm-up are excluded.")

                    Button("Benchmark strings (1,000)") {
                        benchmarkStore.enableCompareBeforeSet()
                        benchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        for index in 0..<10 {
                            benchmarkStore.getString(benchmarkStringKey)
                            benchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        }

                        benchmarkStartedAt = Time.monotonic()
                        for index in 0..<1000 {
                            benchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        }
                        stringWriteNs = Time.elapsed(since: benchmarkStartedAt)

                        benchmarkStore.enableCompareBeforeSet()
                        benchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        for index in 0..<10 {
                            benchmarkStore.getString(benchmarkStringKey)
                        }
                        benchmarkStartedAt = Time.monotonic()
                        for index in 0..<1000 {
                            benchmarkStore.getString(benchmarkStringKey)
                        }
                        stringReadNs = Time.elapsed(since: benchmarkStartedAt)

                        compareBenchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        compareBeforeSetDisabled = compareBenchmarkStore.disableCompareBeforeSet()
                        for index in 0..<10 {
                            compareBenchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        }
                        benchmarkStartedAt = Time.monotonic()
                        for index in 0..<1000 {
                            compareBenchmarkStore.setString(benchmarkStringKey, benchmarkStringValue)
                        }
                        stringWriteWithoutComparisonNs = Time.elapsed(since: benchmarkStartedAt)
                        Log.info(message: "MMKV string read: $stringReadNs ns; write with compare-before-set: $stringWriteNs ns; write without comparison: $stringWriteWithoutComparisonNs ns (disable accepted: $compareBeforeSetDisabled)")
                    }
                    Text("String read: $stringReadNs ns; write with compare-before-set: $stringWriteNs ns")
                    Text("Write without comparison: $stringWriteWithoutComparisonNs ns (disabled: $compareBeforeSetDisabled)")

                    Button("Benchmark Int32 (1,000)") {
                        benchmarkGeneration = benchmarkGeneration + 1
                        intReadKeys = []
                        intWriteEntries = []
                        for index in 0..<1000 {
                            intReadKeys.append("bench-int-read-$index")
                            store.setInt32("bench-int-read-$index", index)
                            intWriteEntries.append(BenchmarkIntEntry(
                                "bench-int-write-$index",
                                benchmarkGeneration + index
                            ))
                        }
                        for index in 0..<10 {
                            store.getInt32(intReadKeys[index])
                            store.setInt32("bench-int-warm-$index", benchmarkGeneration + index)
                        }

                        benchmarkStartedAt = Time.monotonic()
                        for key in intReadKeys {
                            store.getInt32(key)
                        }
                        intReadNs = Time.elapsed(since: benchmarkStartedAt)

                        benchmarkStartedAt = Time.monotonic()
                        for entry in intWriteEntries {
                            store.setInt32(entry.key, entry.value)
                        }
                        intWriteNs = Time.elapsed(since: benchmarkStartedAt)
                        Log.info(message: "MMKV Int32 read: $intReadNs ns; write: $intWriteNs ns")
                    }
                    Text("Int32 read: $intReadNs ns; write: $intWriteNs ns")

                    Button("Benchmark 500-object lists (1,000)") {
                        benchmarkGeneration = benchmarkGeneration + 1
                        benchmarkObjects = []
                        for index in 0..<500 {
                            benchmarkObjects.append(BenchmarkObject(index, benchmarkGeneration, "object-$index"))
                        }
                        listReadKeys = []
                        listWriteKeys = []
                        for index in 0..<1000 {
                            listReadKeys.append("bench-list-read-$index")
                            listWriteKeys.append("bench-list-write-$index")
                            store.setList<BenchmarkObject>("bench-list-read-$index", benchmarkObjects)
                        }
                        for index in 0..<3 {
                            store.getList<BenchmarkObject>(listReadKeys[index])
                            store.setList<BenchmarkObject>("bench-list-warm-$index", benchmarkObjects)
                        }

                        benchmarkStartedAt = Time.monotonic()
                        for key in listReadKeys {
                            store.getList<BenchmarkObject>(key)
                        }
                        listReadNs = Time.elapsed(since: benchmarkStartedAt)

                        benchmarkStartedAt = Time.monotonic()
                        for key in listWriteKeys {
                            store.setList<BenchmarkObject>(key, benchmarkObjects)
                        }
                        listWriteNs = Time.elapsed(since: benchmarkStartedAt)
                        Log.info(message: "MMKV 500-object list read: $listReadNs ns; write: $listWriteNs ns")
                    }
                    Text("500-object list read: $listReadNs ns; write: $listWriteNs ns")
                }
            }

            Tab(index: 1, label: "Conformance", icon: "checkmark") {
                Column(spacing: 12) {
                    Button("Generic ees") {
                        store.setObject("options", PlayerOptions(true, 0.5, PlaybackState.playing, ["a"]))
                        store.setObject("ratio", 0.75)
                        store.setList<Int32>("launches-list", [1, 2, 3])
                        store.setSet<String>("tags", ["a", "b"])
                        store.setMap<String, Int32>("highScores", highScores)
                        store.setList<Chapter>("chapters", [Chapter("intro", 90)])

                        options = store.getObject("options")
                        ratio = store.getObject<Float64>("ratio") ?? 0
                        tags = store.getSet<String>("tags") ?? []
                        highScores = store.getMap<String, Int32>("highScores") ?? ["none": 0]
                        chapters = store.getList<Chapter>("chapters") ?? []
                    }

                    Button("Key space") {
                        keys = store.getAllKeys()
                        keys = store.getAllKeysWithPrefix("options")
                        keys = store.getAllKeysWithSuffix("e")
                        keys = store.getAllKeysMatching("opt", "s")
                        store.remove("name")
                        store.removeMany(["raw", "ratio"])
                        store.trim()
                        keyCount = store.count()
                        totalSize = store.totalSize()
                        actualSize = store.actualSize()
                        pageSize = store.pageSize
                        store.sync()
                        store.asyncFlush()
                        store.checkContentChanged()
                    }

                    Button("Files") {
                        store.backup("conformance-backup")
                        store.restore("conformance-backup")
                    }

                    Button("Clear") {
                        store.clearAll()
                        options = null
                        tags = []
                        chapters = []
                    }
                }
            }
        }
    }
}

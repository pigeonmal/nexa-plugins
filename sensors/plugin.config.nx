plugin {
    schema: 2
    id: "dev.nexa.sensors"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
    }
    android {
        minSdk: 26
        sources: ["android/src/main/kotlin/**/*.kt"]
    }
}

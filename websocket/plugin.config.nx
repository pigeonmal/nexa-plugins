plugin {
    schema: 2
    id: "dev.nexa.websocket"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "13.0"
        sources: ["ios/Sources/**/*.swift"]
    }
    android {
        minSdk: 21
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: ["com.squareup.okhttp3:okhttp:5.5.0"]
        permissions: ["android.permission.INTERNET"]
    }
}

plugin {
    schema: 2
    id: "dev.nexa.mail-composer"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "16.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["MessageUI", "UIKit"]
    }
    android {
        minSdk: 23
        sources: ["android/src/main/kotlin/**/*.kt"]
    }
}

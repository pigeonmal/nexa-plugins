plugin {
    schema: 2
    id: "dev.nexa.webview"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["WebKit"]
    }
    android {
        minSdk: 24
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: ["androidx.webkit:webkit:1.17.1"]
        permissions: ["android.permission.INTERNET"]
    }
}

plugin {
    schema: 2
    id: "dev.nexa.video-player"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["AVFoundation", "AVKit"]
    }
    android {
        minSdk: 23
        pictureInPicture: true
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: [
            "androidx.media3:media3-exoplayer:1.11.1",
            "androidx.media3:media3-exoplayer-hls:1.11.1",
            "androidx.media3:media3-exoplayer-dash:1.11.1",
            "androidx.media3:media3-datasource-cronet:1.11.1",
            "androidx.media3:media3-ui:1.11.1",
            "org.chromium.net:cronet-embedded:143.7445.0",
            "io.github.anilbeesetti:nextlib-media3ext:1.11.1-0.16.0",
        ]
        permissions: ["android.permission.INTERNET"]
    }
}

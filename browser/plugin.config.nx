plugin {
    schema: 2
    id: "dev.nexa.browser"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "16.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["SafariServices", "UIKit"]
    }
    android {
        minSdk: 23
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: ["androidx.browser:browser:1.10.0"]
    }
}

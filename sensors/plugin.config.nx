plugin {
    schema: 2
    id: "dev.nexa.sensors"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["CoreMotion"]
        usageDescriptions {
            NSMotionUsageDescription: "Motion and barometer data is used only for the sensor features you start."
        }
    }
    android {
        minSdk: 26
        sources: ["android/src/main/kotlin/**/*.kt"]
        permissions: ["android.permission.ACTIVITY_RECOGNITION"]
    }
}

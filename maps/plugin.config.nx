plugin {
    schema: 2
    id: "dev.nexa.maps"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["MapKit"]
    }
    android {
        minSdk: 23
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: ["com.google.maps.android:maps-compose:8.6.0"]
        permissions: ["android.permission.INTERNET"]
        applicationMetadata {
            "com.google.android.geo.API_KEY": "${NEXA_MAPS_API_KEY}"
        }
    }
}

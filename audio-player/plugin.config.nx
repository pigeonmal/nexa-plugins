plugin {
    schema: 2
    id: "dev.nexa.audio-player"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "17.0"
        sources: ["ios/Sources/**/*.swift"]
        frameworks: ["AVFoundation", "MediaPlayer"]
        backgroundModes: ["audio"]
    }
    android {
        minSdk: 26
        sources: ["android/src/main/kotlin/**/*.kt"]
        dependencies: [
            "androidx.media3:media3-exoplayer:1.11.1",
            "androidx.media3:media3-exoplayer-hls:1.11.1",
            "androidx.media3:media3-session:1.11.1",
        ]
        permissions: ["android.permission.INTERNET", "android.permission.WAKE_LOCK"]
        mediaPlaybackService: "dev.nexa.audio.AudioPlaybackService"
    }
}

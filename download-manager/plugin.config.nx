plugin {
    schema: 2
    id: "dev.nexa.download-manager"
    version: "0.1.0"
    hostCapabilities: ["network"]
    sources {
        native: "native.nxid"
    }
    ios {
        minVersion: "16.0"
        sources: ["ios/Sources/**/*.swift"]
    }
    android {
        minSdk: 24
        sources: ["android/src/main/kotlin/**/*.kt"]
        permissions: ["android.permission.INTERNET"]
    }
}

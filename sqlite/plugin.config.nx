plugin {
    schema: 2
    id: "dev.nexa.sqlite"
    version: "0.1.0"
    sources {
        native: "native.nxid"
    }
    compiler {
        analyzer: ["cargo", "run", "--quiet", "--manifest-path", "compiler/Cargo.toml"]
    }
    ios {
        minVersion: "13.0"
        sources: ["ios/Sources/**/*.swift"]
        extensionSources: ["ios/Sources/**/*.swift"]
        linkerFlags: ["-lsqlite3"]
    }
    android {
        minSdk: 23
        sources: ["android/src/main/kotlin/**/*.kt"]
    }
}

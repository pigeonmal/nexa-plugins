// Standard text and binary WebSockets, implemented with native platform clients.
enum WebSocketState {
    idle
    connecting
    open
    reconnecting
    closing
    closed
    failed
}

error WebSocketError {
    invalidUrl
    alreadyConnected
}

native class WebSocket {
    init(url: String)

    readonly property state: WebSocketState

    /// Starts one connection. Handshake success and failure arrive as state events.
    async fn connect() throws WebSocketError
    fn configureReconnect(maxAttempts: Int32)

    /// Returns true when the local platform queue accepts the message; this does not confirm peer delivery.
    fn send(text: String) -> Bool
    fn sendBytes(bytes: Bytes) -> Bool

    /// Starts a normal RFC 6455 close handshake.
    fn close()
    fn dispose()

    event stateChanged(state: WebSocketState)
    event reconnecting(attempt: Int32, delayMillis: Int32)
    event messageReceived(text: String)
    event binaryReceived(bytes: Bytes)
    event failed(message: String)
}
